<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.libarymanagementsystem.controller.RequestDetailDialogController"
      spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Chi Tiết Yêu Cầu" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <Label text="Chủ Đề:" style="-fx-font-weight: bold;" />
    <TextArea fx:id="subjectTextArea" editable="false" wrapText="true" prefRowCount="2" />

    <Label text="Nội Dung:" style="-fx-font-weight: bold;" />
    <TextArea fx:id="contentTextArea" editable="false" wrapText="true" prefRowCount="10" />

    <Button text="Đóng" onAction="#handleClose" alignment="CENTER_RIGHT" />

</VBox>