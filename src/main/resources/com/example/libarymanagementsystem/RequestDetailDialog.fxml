<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" style="-fx-background-color: #e3e9f0;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.libarymanagementsystem.controller.RequestDetailDialogController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-weight: bold;" text="Chi Tiết Yêu Cầu">
      <font>
         <Font name="System Bold" size="24.0" />
      </font></Label>

    <Label style="-fx-font-weight: bold;" text="Chủ Đề:" />
    <TextArea fx:id="subjectTextArea" editable="false" prefRowCount="2" wrapText="true" />

    <Label style="-fx-font-weight: bold;" text="Nội Dung:" />
    <TextArea fx:id="contentTextArea" editable="false" prefRowCount="10" wrapText="true" />

    <Button alignment="CENTER_RIGHT" onAction="#handleClose" style="-fx-background-radius: 30; -fx-background-color: #f1a7b1;" text="Đóng" />

</VBox>
