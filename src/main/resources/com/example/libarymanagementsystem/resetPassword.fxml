<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.libarymanagementsystem.ResetPasswordController">
    <children>
        <!-- Trường nhập mã xác nhận -->
        <Label layoutX="50" layoutY="30" text="Nhập mã xác nhận:"/>
        <TextField fx:id="codeField" layoutX="50" layoutY="60" prefWidth="200"/>

        <!-- Nút xác minh mã -->
        <Button fx:id="verifyCodeButton" layoutX="50" layoutY="100" text="Xác minh mã" onAction="#verifyCode"/>

        <!-- Trường nhập mật khẩu mới (ẩn ban đầu) -->
        <Label fx:id="newPasswordLabel" layoutX="50" layoutY="140" text="Mật khẩu mới:" visible="false"/>
        <PasswordField fx:id="newPasswordField" layoutX="50" layoutY="170" prefWidth="200" visible="false"/>

        <!-- Thêm trường xác nhận mật khẩu mới (ẩn ban đầu) -->
        <Label fx:id="confirmPasswordLabel" layoutX="50" layoutY="210" text="Xác nhận mật khẩu:" visible="false"/>
        <PasswordField fx:id="confirmPasswordField" layoutX="50" layoutY="240" prefWidth="200" visible="false"/>

        <!-- Nút đặt lại mật khẩu (ẩn ban đầu) -->
        <Button fx:id="resetButton" layoutX="50" layoutY="280" text="Đặt lại mật khẩu" onAction="#resetPassword" visible="false"/>
    </children>
</AnchorPane>