<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.libarymanagementsystem.ForgotPasswordController">
    <children>
        <Label layoutX="80.0" layoutY="14.0" text="Quên mật khẩu" textFill="#298e61">
            <font>
                <Font name="Tahoma Bold" size="19.0" />
            </font>
        </Label>
        <TextField fx:id="usernameField" layoutX="50.0" layoutY="80.0" prefHeight="30.0" prefWidth="250.0" promptText="Tên đăng nhập hoặc Email" />
        <Button fx:id="submitButton" layoutX="50.0" layoutY="140.0" mnemonicParsing="false" onAction="#sendResetPassword" prefHeight="40.0" prefWidth="250.0" text="Gửi yêu cầu" />
    </children>
</AnchorPane>