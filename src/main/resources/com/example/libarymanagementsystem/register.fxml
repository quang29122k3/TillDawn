<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.libarymanagementsystem.RegisterController">
    <children>
        <Label layoutX="100.0" layoutY="14.0" text="Đăng ký tài khoản" textFill="#298e61">
            <font>
                <Font name="Tahoma Bold" size="19.0" />
            </font>
        </Label>
        <TextField fx:id="usernameField" layoutX="50.0" layoutY="60.0" prefHeight="30.0" prefWidth="250.0" promptText="Tên đăng nhập" />
        <PasswordField fx:id="passwordField" layoutX="50.0" layoutY="110.0" prefHeight="30.0" prefWidth="250.0" promptText="Mật khẩu" />
        <PasswordField fx:id="confirmPasswordField" layoutX="50.0" layoutY="160.0" prefHeight="30.0" prefWidth="250.0" promptText="Xác nhận mật khẩu" />
        <TextField fx:id="emailField" layoutX="50.0" layoutY="210.0" prefHeight="30.0" prefWidth="250.0" promptText="Email" />
        <Button fx:id="registerButton" layoutX="50.0" layoutY="270.0" mnemonicParsing="false" onAction="#registerAccount" prefHeight="40.0" prefWidth="250.0" text="Đăng ký" />
    </children>
</AnchorPane>
